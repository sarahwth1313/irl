type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserProfile = 
 record {
   displayName: text;
   verifiedEmail: opt text;
 };
type Timestamp = nat;
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type MessageId = nat;
type Message = 
 record {
   author: principal;
   authorName: text;
   createdAt: Timestamp;
   id: MessageId;
   "text": text;
 };
type ItemId = nat;
type Item = 
 record {
   activityId: opt text;
   address: opt text;
   ageRequirements: opt text;
   area: text;
   category: Category;
   createdAt: Timestamp;
   createdBy: principal;
   dateOrHours: opt text;
   endDate: opt text;
   fullDescription: text;
   id: ItemId;
   lastVerified: opt text;
   mapsLink: opt text;
   price: opt text;
   registrationLink: opt text;
   shortDescription: text;
   sourceLink: opt text;
   startDate: opt text;
   startTime: opt text;
   status: opt text;
   tags: vec text;
   title: text;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type Category = 
 variant {
   culture;
   events;
   food;
   places;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  addItem: (title: text, category: Category, area: text, shortDescription:
   text, fullDescription: text, dateOrHours: opt text, activityId: opt text,
   startDate: opt text, startTime: opt text, endDate: opt text, price:
   opt text, ageRequirements: opt text, address: opt text, registrationLink:
   opt text, mapsLink: opt text, sourceLink: opt text, lastVerified:
   opt text, status: opt text, tags: vec text) -> (Item);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  execute: (qJson: text) -> (Result) query;
  getApiDoc: () -> (text) query;
  getCallerEmail: () -> (opt text) query;
  getCallerUserProfile: () -> (opt UserProfile) query;
  getCallerUserRole: () -> (UserRole) query;
  isCallerAdmin: () -> (bool) query;
  listItems: () -> (vec Item) query;
  listMessages: () -> (vec Message) query;
  postMessage: ("text": text) -> (Message);
  saveCallerUserProfile: (displayName: text) -> (UserProfile);
  schema: () -> (text) query;
}
